<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Goals</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Goals</h1>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Amount</th>
                    <th>Amount Reached</th>
                    <th>User Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% goals.forEach(goal => { %>
                <tr>
                    <td><%= goal.name %></td>
                    <td><%= goal.amount %></td>
                    <td><%= goal.current %></td>
                    <td><%= goal.user_email %></td>
                    <td>
                        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#editGoal<%= goal.id %>">Edit</button>
                        <form action="/deleteGoal/<%= encodeURIComponent(goal.id) %>" method="POST" class="d-inline"
                              onsubmit="return confirm('Delete goal <%= goal.id %>?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <% goals.forEach(goal => { %>
                <div class="modal fade" id="editGoal<%= goal.id %>" tabindex="-1" aria-labelledby="editGoalLabel<%= goal.id %>" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form action="/editGoal/<%= encodeURIComponent(goal.id) %>" method="POST">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5" id="editGoalLabel<%= goal.id %>">Edit Goal</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label" for="editName<%= goal.id %>">Name</label>
                                        <input class="form-control" id="editName<%= goal.id %>" name="name" value="<%= goal.name %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="editAmount<%= goal.id %>">Amount</label>
                                        <input class="form-control" type="number" min="0" step="any" id="editAmount<%= goal.id %>" name="amount" value="<%= goal.amount %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="editCurrent<%= goal.id %>">Amount Reached</label>
                                        <input class="form-control" type="number" min="0" step="any" id="editCurrent<%= goal.id %>" name="current" value="<%= goal.current %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="editUserEmail<%= goal.id %>">User Email</label>
                                        <input class="form-control" type="email" min="1" step="1" id="editUserEmail<%= goal.user_email %>" name="user_email" value="<%= goal.user_email %>" required>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
        <% }) %>

        <a class="btn btn-secondary" href="/">Home</a>
        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#addGoal">Add Goal</button>
    </div>

    <div class="modal fade" id="addGoal" tabindex="-1" aria-labelledby="addGoalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/addGoal" method="POST">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="addGoalLabel">Create Goal</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="goalName">Name</label>
                            <input class="form-control" id="goalName" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="goalAmount">Amount</label>
                            <input class="form-control" type="number" min="0" step="any" id="goalAmount" name="amount" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="goalCurrent">Amount Reached</label>
                            <input class="form-control" type="number" min="0" step="any" id="goalCurrent" name="current" value="0" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="goalUserEmail">User Email</label>
                            <input class="form-control" type="email" min="1" step="1" id="goalUserEmail" name="user_email" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Create Goal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
