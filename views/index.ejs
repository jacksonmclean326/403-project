<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <span class="navbar-brand"><a href="https://tinyurl.com/24pnvb34">Mr Money Man</a> Admin Portal</span>
            <% if (loggedIn) { %>
            <a class="btn btn-outline-secondary" href="/logout">Logout</a>
            <% } else { %>
            <form class="d-flex gap-2" action="/login" method="post">
                <input class="form-control" type="text" id="username" name="username" placeholder="User name" required>
                <input class="form-control" type="password" id="password" name="password" placeholder="Password" required>
                <button class="btn btn-primary" type="submit">Submit</button>
            </form>
            <% } %>
        </div>
    </nav>

    <div class="container mt-4">
        <p>Welcome to the admin portal</p>

        <img src="/images/money-man-mascot.png" alt="Money man Logo" class="img-fluid rounded mb-3" style="max-width: 300px;"/>
        <% if (loggedIn) { %>
        <a class="btn btn-primary" href="/users">Maintain Users</a>
        <a class="btn btn-success" href="/budgets">Maintain Records</a>
        <% } else { %>
        <p>Please sign in to access admin features</p>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
